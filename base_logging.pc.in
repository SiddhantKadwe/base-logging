prefix=@CMAKE_INSTALL_PREFIX@
exec_prefix=@CMAKE_INSTALL_PREFIX@
libdir=${prefix}/lib
includedir=${prefix}/include/base_logging

Name: base_logging
Description: Base logging library for robotic applications
Version: @PROJECT_VERSION@
Requires: @PKGCONFIG_REQUIRES@
Libs: -L${libdir} -lbase_logging
Cflags: -I${includedir}

